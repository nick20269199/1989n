# Feishu Webhook URL (from bot configuration)
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token

# Feishu Open API (for Sheets/Table sync)
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret
FEISHU_SPREADSHEET_TOKEN=shtcnxxxxxxxxxx
FEISHU_PORTFOLIO_SHEET_ID=sht12
FEISHU_REPORT_SHEET_ID=sht13
FEISHU_NEWS_SHEET_ID=sht14

# StockAPI (stockapi.com.cn) - for sentiment/emotional cycle data
STOCKAPI_TOKEN=your_stockapi_token

# Database path
DATABASE_PATH=D:/1989n/stock_data/stock.db

# Data directories
STOCK_DATA_DIR=D:/1989n/stock_data
SCREENSHOT_DIR=D:/1989n/screenshots

# Logging
LOG_LEVEL=INFO
