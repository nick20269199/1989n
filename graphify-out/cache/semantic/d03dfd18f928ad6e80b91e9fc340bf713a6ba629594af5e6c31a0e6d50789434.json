{"nodes": [{"id": "feedback_cron_durable_durable_cron_requirement", "label": "Durable Cron Requirement", "file_type": "rationale", "source_file": ".claude/memory/feedback/feedback_cron_durable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All CronCreate calls must use durable:true without exception. Session-only cron tasks (default durable:false) disappear when the session ends, causing silent task loss. Durable cron tasks auto-expire after 7 days and need weekly self-renewal."}, {"id": "feedback_cron_durable_windows_task_bat_wrapper", "label": "Windows Task BAT Wrapper", "file_type": "rationale", "source_file": ".claude/memory/feedback/feedback_cron_durable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows scheduled tasks must be wrapped in .bat files that use cd /d to set the working directory, because the Windows Task Scheduler runs with an empty WorkingDirectory by default, causing FILE NOT FOUND errors."}, {"id": "system_scheduled_tasks_file", "label": "scheduled_tasks.json", "file_type": "document", "source_file": ".claude/memory/feedback/feedback_cron_durable.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "feedback_cron_durable_durable_cron_requirement", "target": "system_scheduled_tasks_file", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/memory/feedback/feedback_cron_durable.md", "source_location": null, "weight": 1.0}, {"source": "feedback_cron_durable_windows_task_bat_wrapper", "target": "feedback_cron_durable_durable_cron_requirement", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/memory/feedback/feedback_cron_durable.md", "source_location": null, "weight": 1.0}, {"source": "feedback_cron_durable_durable_cron_requirement", "target": "feedback_scheduled_task_reliability_task_reliability_verification", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/memory/feedback/feedback_cron_durable.md", "source_location": null, "weight": 1.0}], "hyperedges": []}