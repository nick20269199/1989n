  <data key="d17">{"source": "潜夫论_15篇精读", "total_signals": 28, "top_signals": ["守本离末则富离本守末则贫 = root (discipline/risk/system) before branch (flashy tips)", "道成于学而藏于书 = trading mastery through learning + note-taking", "兼听则明偏信则暗 = multi-angle analysis prevents bias", "明者见形暗者闻声 = see essence not noise", "明者慎微智者识几 = masters attend to small details", "富贵太盛则骄佚而生过 = big profit breeds arrogance then error", "功以日力 = profit through daily accumulation", "不务治事而务治心 = highest realm: manage heart/mind not transactions"]}</data>
