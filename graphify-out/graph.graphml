  <data key="d17">{"author": "Jessica Flack", "complexity_branch": "branch_C_complex_systems", "core_insight": "社会抑制机制在集体决策中维持秩序——信息的流动和抑制同等重要", "trading_penetration": "市场中的“社会抑制”(涨停板/停牌)同样引导信息流方向——抑制被解除时爆发最剧烈", "date": "2026-05-27", "source_file": "stock_data/reading_notes/2026-05-27_弗拉克计算社会_社会抑制与信息流_交易穿透.md"}</data>
