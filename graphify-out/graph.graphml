  <data key="d0">concept</data>
  <data key="d1">自组织临界性 SOC</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "系统自发达到临界状态，任何小扰动可触发任意大小的事件", "trading_application": "市场暴跌是临界状态的正常释放，监控临界程度而非预测触发事件"}</data>
  <data key="d5">46</data>
</node>
<node id="concept-power-law">
  <data key="d0">concept</data>
  <data key="d1">幂律分布</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "事件大小服从幂律，无特征尺度，极端事件比正态预测频繁得多", "trading_application": "仓位设到即使金融危机再现也不爆仓，追求小亏+少数大盈而非高胜率"}</data>
  <data key="d5">46</data>
</node>
<node id="concept-scale-free-network">
  <data key="d0">concept</data>
  <data key="d1">无标度网络</data>
  <data key="d17">{"domain": "network_science", "key_insight": "度分布呈幂律，少数枢纽节点拥有大部分连接", "trading_application": "少数枢纽品种控制全局，板块枢纽品种的走势预示板块走向，早反应1-3天"}</data>
  <data key="d5">46</data>
</node>
<node id="concept-preferential-attachment">
  <data key="d0">concept</data>
  <data key="d1">优先连接(富者愈富)</data>
  <data key="d17">{"domain": "network_science", "key_insight": "新节点更倾向连接已有大量连接的节点，马太效应", "trading_application": "资金倾向高关注品种，跟随早期阶段，关注度饱和前退出"}</data>
  <data key="d5">46</data>
</node>
<node id="concept-small-world">
  <data key="d0">concept</data>
  <data key="d1">小世界网络</data>
  <data key="d17">{"domain": "network_science", "key_insight": "高聚类系数+短路径长度，仅需1%随机重连即可大幅缩短路径", "trading_application": "持仓品种间存在意想不到的短路径，识别桥接品种，1%调整可能产生跃迁"}</data>
  <data key="d5">46</data>
</node>
<node id="concept-kuramoto-sync">
  <data key="d0">concept</data>
  <data key="d1">Kuramoto自发同步</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "耦合强度K超过临界值K_c时，大量振荡器自发同步，序参量跃升", "trading_application": "市场同步度三区间管理：&lt;0.3减仓观望/0.3-0.7正常交易/&gt;0.7过度同步大幅减仓"}</data>
  <data key="d5">46</data>
</node>
<node id="concept-cas">
  <data key="d0">concept</data>
  <data key="d1">复杂适应系统 CAS</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "大量适应性主体交互产生涌现现象，反馈闭环永不停止", "trading_application": "市场是CAS，优势不在预测在适应速度，系统需具备四大要素"}</data>
  <data key="d5">104</data>
</node>
<node id="concept-emergence">
  <data key="d0">concept</data>
  <data key="d1">涌现</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "简单规则+大量交互+反馈产生全局秩序，整体不能简化为个体", "trading_application": "自下而上设计底层规则让系统涌现表现，观测组合夏普&gt;加权夏普"}</data>
  <data key="d5">104</data>
</node>
<node id="concept-feedback-loop">
  <data key="d0">concept</data>
  <data key="d1">反馈回路</data>
  <data key="d17">{"domain": "systems_thinking", "key_insight": "正反馈驱动增长/崩溃，负反馈驱动稳定，延迟是系统振荡主因", "trading_application": "画出系统反馈回路图，识别主导回路，增强负反馈(自动止损/减仓)"}</data>
  <data key="d5">103</data>
</node>
<node id="concept-leverage-point">
  <data key="d0">concept</data>
  <data key="d1">杠杆点</data>
  <data key="d17">{"domain": "systems_thinking", "key_insight": "系统中微小变化可引发巨大行为改变的干预点，从参数到范式共12级", "trading_application": "从最强杠杆(交易目标/市场假设)开始审查，认知性杠杆比技术性杠杆更有价值"}</data>
  <data key="d5">103</data>
</node>
<node id="concept-edge-of-chaos">
  <data key="d0">concept</data>
  <data key="d1">混沌边缘</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "系统在有序与混沌之间达到最优适应，计算能力最大", "trading_application": "80%纪律+20%酌情，纪律保持稳定，酌情允许创新，比例随波动率动态调节"}</data>
  <data key="d5">104</data>
</node>
<node id="concept-computational-equivalence">
  <data key="d0">concept</data>
  <data key="d1">计算等价性原理</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "所有表现出非平凡复杂性的系统在计算能力上等价", "trading_application": "你无法比市场聪明，优势来自策略程序与市场程序的有用不对齐"}</data>
  <data key="d5">202</data>
</node>
<node id="concept-computational-irreducibility">
  <data key="d0">concept</data>
  <data key="d1">计算不可约减性</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "某些过程不能被加速预测，只能运行它等待结果", "trading_application": "分析30分钟仍不能决定→小仓位试，参与优于分析"}</data>
  <data key="d5">202</data>
</node>
<node id="concept-phase-space-reconstruction">
  <data key="d0">concept</data>
  <data key="d1">相空间重构</data>
  <data key="d17">{"domain": "nonlinear_dynamics", "key_insight": "一维时间序列可嵌入高维相空间发现低维确定性结构", "trading_application": "构建5维状态向量(价量波动率情绪盈亏)，用历史相似点预测后续"}</data>
  <data key="d5">103</data>
</node>
<node id="concept-social-inhibition">
  <data key="d0">concept</data>
  <data key="d1">社会抑制</data>
  <data key="d17">{"domain": "computational_social_science", "key_insight": "抑制噪声传播比促进信息流通更能提高集体决策质量", "trading_application": "信息源分级审核，一级官方公告直接通过，三级社交媒体默认抑制"}</data>
  <data key="d5">104</data>
</node>
<node id="concept-autocatalytic-closure">
  <data key="d0">concept</data>
  <data key="d1">自催化闭包</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "系统中每种分子的生产都被系统内另一种分子催化，系统自我维持", "trading_application": "策略间建信息催化环，从操控者变园艺师，系统自我运转"}</data>
  <data key="d5">201</data>
</node>
<node id="concept-critical-slowing-down">
  <data key="d0">concept</data>
  <data key="d1">临界减速</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "系统接近相变时从扰动中恢复的速度变慢，是体制切换前兆", "trading_application": "检测价格自相关衰减时间变长+多框架同时慢化→减仓30-50%+策略切换准备"}</data>
  <data key="d5">227</data>
</node>
<node id="concept-adjacent-possible">
  <data key="d0">concept</data>
  <data key="d1">邻接可能</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "创新来自当前状态的边界上的一小步，不是远距离跳跃", "trading_application": "为每个策略绘邻接可能地图，分配10%预算探索边界，跨越太大预警"}</data>
  <data key="d5">203</data>
</node>
<node id="concept-generative-explanation">
  <data key="d0">concept</data>
  <data key="d1">生成解释</data>
  <data key="d17">{"domain": "methodology", "key_insight": "只有能从底层规则生成宏观现象才算真正理解", "trading_application": "能从简单市场假设+策略规则生成与真实相似的结果才算理解策略"}</data>
  <data key="d5">79</data>
</node>
<node id="concept-heterogeneity">
  <data key="d0">concept</data>
  <data key="d1">异质性</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "系统中主体的差异是适应性的关键来源，同质化导致集体脆弱", "trading_application": "策略间核心逻辑假设必须不同(趋势/均值回归/事件驱动)，参数不同但逻辑同=伪异质"}</data>
  <data key="d5">104</data>
</node>
<node id="concept-community-detection">
  <data key="d0">concept</data>
  <data key="d1">社区检测与模块度</data>
  <data key="d17">{"domain": "network_science", "key_insight": "模块度Q量化社区结构质量，Q&gt;0.3有显著社区结构", "trading_application": "持仓做社区检测，Q&gt;0.7=健康多社区，社区漂移(不同社区同涨)=系统性风险信号"}</data>
  <data key="d5">226</data>
</node>
<node id="concept-threshold-cascade">
  <data key="d0">concept</data>
  <data key="d1">阈值级联传播</data>
  <data key="d17">{"domain": "network_science", "key_insight": "当感染比例超过阈值时整个网络突然翻转，产生级联效应", "trading_application": "监控品种关注度/成交量接近历史阈值=级联将触发，反级联时系统减仓不等确认"}</data>
  <data key="d5">226</data>
</node>
<node id="concept-effective-complexity">
  <data key="d0">concept</data>
  <data key="d1">有效复杂度</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "系统规律性的描述长度，不是总复杂度，完全随机系统有效复杂度为零", "trading_application": "审计每个指标捕捉了什么独立可持续的规律，答不出=装饰复杂度删除"}</data>
  <data key="d5">225</data>
</node>
<node id="concept-coarse-graining">
  <data key="d0">concept</data>
  <data key="d1">粗粒化</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "在正确的抽象层级上观察系统，暴露规律隐藏噪声", "trading_application": "找到基础交易尺度的最优粗粒化，小尺度=噪声大尺度=参考"}</data>
  <data key="d5">225</data>
</node>
<node id="concept-policy-resistance">
  <data key="d0">concept</data>
  <data key="d1">政策抵抗</data>
  <data key="d17">{"domain": "systems_thinking", "key_insight": "干预激活系统补偿性反馈抵消干预效果，不是执行不力是结构性的", "trading_application": "每次干预前预判补偿性反馈(买→谁卖卖→谁接)，区分反馈(有限)vs反转(持续)"}</data>
  <data key="d5">103</data>
</node>
<node id="concept-robust-yet-fragile">
  <data key="d0">concept</data>
  <data key="d1">稳健但脆弱</data>
  <data key="d17">{"domain": "complex_systems", "key_insight": "系统对常规扰动稳健但对特定罕见攻击极端脆弱", "trading_application": "长期稳健可能意味着高度优化于常规市场，用未见场景压力测试"}</data>
  <data key="d5">227</data>
</node>
<node id="concept-burstiness">
  <data key="d0">concept</data>
  <data key="d1">爆发性</data>
  <data key="d17">{"domain": "human_behavior", "key_insight": "人类行为呈长时间静默+短时间密集行动的幂律等待时间模式", "trading_application": "爆发期内设决策间隔(&lt;15分钟1决策)，静默期安排非决策任务"}</data>
  <data key="d5">46</data>
</node>
<node id="concept-social-multiplier">
  <data key="d0">concept</data>
  <data key="d1">社会乘数</data>
  <data key="d17">{"domain": "network_science", "key_insight": "个体行为通过邻居传播反馈放大为大的集体变化", "trading_application": "正向乘数用移动止盈让利润奔跑，负向乘数等衰竭再介入"}</data>
  <data key="d5">299</data>
</node>
<node id="concept-stock-flow">
  <data key="d0">concept</data>
  <data key="d1">存量-流量陷阱</data>
  <data key="d17">{"domain": "systems_thinking", "key_insight": "人类更关注近期变化(流量)而忽视累积的总量(存量)，导致认知偏差", "trading_application": "每日复盘先审存量(总风险/集中度)再流量(今日盈亏)，最危险=存量高但今天还在赚"}</data>
  <data key="d5">103</data>
</node>
<node id="concept-niche">
  <data key="d0">concept</data>
  <data key="d1">生态位</data>
