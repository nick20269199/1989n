<node id="entity_053_030">
  <data key="d16">Chinese_Classics_Economics_Synthesis_Map</data>
  <data key="d0">cross_domain_mapping</data>
  <data key="d24">integrated_trading</data>
  <data key="d17">{"mappings": [{"chinese_classic": "资治通鉴_才德论_strategy_robustness", "economics": "Klarman_安全边际_risk_first", "merged_insight": "Strategy health (德/robustness) should dominate return (才/profit). Prefer low-return robust over high-return fragile."}, {"chinese_classic": "金刚经_应无所住_mental_detachment", "economics": "Ariely_情绪温差_hot_cold_gap", "merged_insight": "Letting go of attachment to positions/outcomes is the antidote to hot-cold empathy gap."}, {"chinese_classic": "纪效新书_鸳鸯阵_mutual_protection", "economics": "North_模块化设计_modular_system", "merged_insight": "System modules should both create value and protect each other. Modular replaceability ensures evolvability."}, {"chinese_classic": "黄帝内经_法于阴阳_follow_market_rhythm", "economics": "Arthur_非均衡常态_non_equilibrium", "merged_insight": "Market has no fixed equilibrium but seasonal rhythms. Follow the process direction, don't seek the destination."}, {"chinese_classic": "营造法式_材分制_modular_standard", "economics": "North_路径依赖_institutional_design", "merged_insight": "Fixed ratios + variable values = system that scales across capital sizes without losing coherence."}, {"chinese_classic": "诗经_兴观群怨_perceptual_capacities", "economics": "Akerlof_Shiller_动物精神_narrative_economics", "merged_insight": "Market moves on narrative and emotion. '兴'(insight triggered) + '观'(observing) = sensing narrative shifts before they become consensus."}, {"chinese_classic": "潜夫论_兼听则明_multi_perspective", "economics": "Silver_贝叶斯更新_bayesian_update", "merged_insight": "Multi-angle analysis (兼听) = Bayesian updating. Each new data point updates probability, preventing偏信(confirmation bias)."}, {"chinese_classic": "考工记_国工六检_six_quality_gates", "economics": "Thaler_选择架构_choice_architecture", "merged_insight": "Six inspections are a quality assurance system design. Thaler shows environment design &gt; willpower. Both are systematic approaches to execution quality."}, {"chinese_classic": "资治通鉴_惟名与器不可以假人", "economics": "博弈论_可信承诺_credible_commitment", "merged_insight": "Your system's sacred parameters (stop/position) cannot be delegated to emotion. Hard commitment mechanism is the only way to preserve them."}]}</data>
  <data key="d5">192</data>
</node>
