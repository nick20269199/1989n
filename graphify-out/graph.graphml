  <data key="d17">{"convergent_themes": [{"theme": "system_before_action", "books": ["礼记", "资治通鉴", "近思录", "营造法式"]}, {"theme": "root_over_branch", "books": ["潜夫论", "菜根谭", "近思录", "颜氏家训"]}, {"theme": "emotional_detachment", "books": ["金刚经", "黄帝内经", "诗经", "菜根谭"]}, {"theme": "small_signals_early_action", "books": ["潜夫论", "资治通鉴", "黄帝内经", "近思录"]}, {"theme": "trust_and_execute_system", "books": ["资治通鉴", "金刚经", "纪效新书", "礼记"]}, {"theme": "post_profit_humility", "books": ["潜夫论", "菜根谭", "诗经", "礼记"]}, {"theme": "continuous_learning", "books": ["颜氏家训", "近思录", "潜夫论", "申鉴"]}]}</data>
