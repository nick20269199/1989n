  <data key="d17">{"author": "Ricard Sole / Brian Goodwin", "complexity_branch": "branch_C_complex_systems", "core_insight": "临界性指标：幂律分布、1/f噪声、临界慢化—系统接近相变的前兆", "trading_penetration": "波动率幂律分布验证；临界慢化(价格恢复时间变长)=趋势即将反转的信号；涨跌分布偏离正态→市场临近相变", "date": "2026-05-27", "source_file": "stock_data/reading_notes/2026-05-27_索莱古德温复杂性的迹象_临界性指标_交易穿透.md"}</data>
