  <data key="d0">book</data>
  <data key="d16">Arthur 经济中的复杂性 — 经济复杂系统</data>
  <data key="d17">{"author": "W. Brian Arthur", "complexity_branch": "branch_C_complex_systems", "core_insight": "经济是复杂适应系统，收益递增与路径依赖决定了市场锁定效应", "trading_penetration": "递增回报策略：早入锁定优势；路径依赖警惕：持仓成本锚定是自我强化的决策陷阱", "date": "2026-05-27", "source_file": "stock_data/reading_notes/2026-05-27_阿瑟经济中的复杂性_经济复杂系统_交易穿透.md"}</data>
